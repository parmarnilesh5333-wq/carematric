# CareMatric AI — Server Environment Configuration
# Copy this file to .env and configure at least one AI provider key for live LLM generation.
# Secrets are read exclusively by the Express backend and are never exposed to the browser.

PORT=3001

# Option 1: Google Gemini API Key (Recommended — uses gemini-2.5-flash or gemini-2.0-flash)
GEMINI_API_KEY=

# Option 2: OpenAI API Key (Fallback — uses gpt-4o-mini)
OPENAI_API_KEY=

# Option 3: Groq API Key (Fallback — uses llama-3.3-70b-versatile)
GROQ_API_KEY=

# Maximum upload size in MB (default: 10)
MAX_UPLOAD_MB=10
